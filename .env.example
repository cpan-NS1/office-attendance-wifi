# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Office network detection: script proceeds when either value matches.
# Connect to office Wi-Fi and run: ipconfig getifaddr en0
OFFICE_IP_PREFIX="9."
# Connect to office Wi-Fi and run: scutil --dns | grep "search domain"
OFFICE_DNS_DOMAIN="ibm.com"

# Monday.com board and employee settings
BOARD_ID="18428037357"
EMPLOYEE_ID="your_employee_id"

# Monday developer API token (profile avatar → Developers → My Access Tokens)
MONDAY_TOKEN="your_monday_api_token"

# Where to store run state and logs (defaults to this repo folder)
STATE_DIR="$(dirname "$0")"
LOG_FILE="$(dirname "$0")/check-office-attendance.log"
