      <sparkle:shortVersionString>1.3.2</sparkle:shortVersionString>
      <pubDate>Wed, 16 Sep 2026 10:55:35 +0000</pubDate>
      <description><![CDATA[
        <h2>What's New in 1.3.2</h2>
        <ul>
          <li><b>Settings:</b> Added Board ID URL helper hint and enforced 7-digit Employee ID format.</li>
          <li><b>History:</b> Persist remote Monday.com fetches directly to local cache.</li>
          <li><b>Stability:</b> Retry transient network disconnects during WiFi switch / sleep wake.</li>
        </ul>
      ]]></description>
