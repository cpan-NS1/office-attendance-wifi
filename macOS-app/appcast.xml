    <title>Office Attendance Updates</title>
    <item>
      <title>Version 1.4.4</title>
      <sparkle:version>16</sparkle:version>
      <sparkle:shortVersionString>1.4.4</sparkle:shortVersionString>
      <pubDate>Wed, 23 Sep 2026 22:33:23 +0000</pubDate>
      <description><![CDATA[
<h2>What's New in v1.4.4</h2><ul><li><b>Fix:</b> Settings window now appears on screen immediately when opened from the menu bar</li><li><b>Settings:</b> Auto-fetches your Board ID and Employee ID — no manual lookup needed</li><li><b>History:</b> Calendar loads instantly from cache while syncing with Monday.com in the background</li><li><b>Stability:</b> Prevents credential decode failure on configs written before employee name was stored</li></ul>
      ]]></description>
      <enclosure url="https://github.com/cpan-NS1/office-attendance-wifi/releases/download/v1.4.4/OfficeAttendance-1.4.4.dmg"
                 sparkle:edSignature="RDTEfICci9NUaNoBsUR8QfN4eNmiGe5MxTX9m21R3kGNoGz4INwdi1YHG7H28SJzGVV9idfrNFjioqP/TXucCg=="
                 length="2790712"
                 type="application/octet-stream"/>
    </item>
    <item>
      <title>Version 1.4.3</title>
      <sparkle:version>15</sparkle:version>
      <sparkle:shortVersionString>1.4.3</sparkle:shortVersionString>
      <pubDate>Wed, 23 Sep 2026 14:23:49 +0000</pubDate>
      <description><![CDATA[
<h2>What's New in 1.4.3</h2><ul><li><b>Fix:</b> Employee IDs up to 8 digits are now accepted — previously the app silently truncated IDs to 7 digits, causing check-in to fail for some users</li></ul>
      ]]></description>
      <enclosure url="https://github.com/cpan-NS1/office-attendance-wifi/releases/download/v1.4.3/OfficeAttendance-1.4.3.dmg"
                 sparkle:edSignature="U6Qya7lVlFcqJr+/sSKRjtXnMF6Fw4gCh8vTQjHc9gjAC2dYSOKTCKDwOGbDA/5AQZak4oT5EPLjWMDdOY60Cg=="
                 length="2723498"
                 type="application/octet-stream"/>
    </item>
    <item>
      <title>Version 1.4.2</title>
      <sparkle:version>14</sparkle:version>
      <sparkle:shortVersionString>1.4.2</sparkle:shortVersionString>
      <pubDate>Wed, 23 Sep 2026 13:49:34 +0000</pubDate>
      <description><![CDATA[
<h2>What's New in 1.4.2</h2><ul><li><b>Fix:</b> Check-in now works correctly on Macs with non-UTC timezones — week dates are computed in UTC to match Monday.com board storage</li><li><b>Fix:</b> Clear error shown when board has not been verified in Settings instead of silently doing nothing</li></ul>
      ]]></description>
      <enclosure url="https://github.com/cpan-NS1/office-attendance-wifi/releases/download/v1.4.2/OfficeAttendance-1.4.2.dmg"
                 sparkle:edSignature="V44r2cqrzyu+Pt04IZEK5SDvU4SkrNr7Qixg0arPTy4Pbx1x1sF2QyJrBliJGSSTR3+1+RbpIUFhGmJJpR+aDw=="
                 length="2728423"
                 type="application/octet-stream"/>
    </item>
    <item>
      <title>Version 1.4.1</title>
      <sparkle:version>13</sparkle:version>
      <sparkle:shortVersionString>1.4.1</sparkle:shortVersionString>
      <pubDate>Wed, 23 Sep 2026 12:22:08 +0000</pubDate>
      <description><![CDATA[
<h2>What's New in 1.4.1</h2><ul><li><b>Fix:</b> New users no longer see "No attendance row found for this week" — the app now scans all board pages, not just the first 500 rows</li></ul>
      ]]></description>
      <enclosure url="https://github.com/cpan-NS1/office-attendance-wifi/releases/download/v1.4.1/OfficeAttendance-1.4.1.dmg"
                 sparkle:edSignature="envvSapCSwT/AKN+jPpWHSm8M/RGBHcRhilIaV7YxMqYSP6pfUbULjY/ieannZBNai9rV5e4bK5msDcmroYxAQ=="
